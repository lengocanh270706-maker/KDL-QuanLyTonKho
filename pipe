# 2. CHUẨN HÓA TÊN CỘT
def normalize_name(value):
    value = str(value).strip().casefold()
    value = unicodedata.normalize("NFKD", value)
    value = "".join(char for char in value if not unicodedata.combining(char))
    value = value.replace("_", " ")
    value = re.sub(r"[^a-z0-9]+", " ", value)
    return re.sub(r"\s+", " ", value).strip()

def normalize_inventory_columns(df):
    df = df.copy()
    df.columns = [str(col).strip() for col in df.columns]
    aliases = {
        "Sku_name": ["Sku_name", "SKU Name", "Sku Name", "SKU_Name", "Product Name"],
        "Sku_code": ["Sku_code", "SKU Code", "Sku Code", "SKU_Code", "Sku"],
        "shop_account": ["shop_account", "SHOP_ACCOUNT", "Shop Account", "Shop_Account"],
        "Tiki": ["Tiki"],
        "Lazada": ["Lazada"],
        "Shopee": ["Shopee"],
        "TikTok": ["TikTok", "Tik Tok"],
        "Sendo": ["Sendo"],
        "Tiki demand per...": ["Tiki demand per...", "Tiki demand", "Tiki Demand Per Day", "Tiki Demand Per Month"],
        "Lazada demand per...": ["Lazada demand per...", "Lazada demand", "Lazada Demand Per Day", "LazadaDemand Per Month"],
        "Shopee demand per...": ["Shopee demand per...", "Shopee demand", "Shopee Demand Per Day", "Shopee Demand Per Month"],
        "TikTok demand per...": ["TikTok  demand per...", "TikTok demand", "TikTok  Demand Per Day", "TikTok Demand Per Month"],
        "Sendo demand per...": ["Sendo demand per...", "Sendo demand", "Sendo  Demand Per Day", "Sendo Demand Per Month"],
        "DOITarget_(days)": ["DOITarget_(days)", "DOI Target (days)", "DOI Target", "DOITarget", "DOI Target Days"],
        "Vendor": ["Vendor", "VENDOR"],
        "Brand": ["Brand", "BRAND"],
    }

    actual_columns = {}
    for col in df.columns:
        key = normalize_name(col)
        actual_columns.setdefault(key, col)
    rename_map = {}
    used_columns = set()

    for target, candidates in aliases.items():
        for candidate in candidates:
            actual = actual_columns.get(normalize_name(candidate))
            if actual is not None and actual not in used_columns:
                rename_map[actual] = target
                used_columns.add(actual)
                break
    df = df.rename(columns=rename_map)

    for col in list(df.columns):
        normalized = normalize_name(col)
        target = None
        for channel in ["Tiki", "Lazada", "Shopee", "TikTok", "Sendo"]:
            channel_normalized = normalize_name(channel)
            if normalized.startswith(channel_normalized + " ") and "demand" in normalized:
                target = f"{channel} demand per..."
                break
        if target and target not in df.columns:
            df = df.rename(columns={col: target})

    for col in list(df.columns):
        normalized = normalize_name(col)
        if "doi" in normalized and ("target" in normalized or "day" in normalized) and "DOITarget_(days)" not in df.columns:
            df = df.rename(columns={col: "DOITarget_(days)"})
            break
    return df

# 3. XỬ LÝ GIÁ TRỊ NULL VÀ KIỂU DỮ LIỆU
def safe_value(value):
    if value is None:
        return None
    try:
        if pd.isna(value):
            return None
    except (TypeError, ValueError):
        pass
    if isinstance(value, np.generic):
        value = value.item()
    if isinstance(value, float) and not math.isfinite(value):
        return None
    return value

def safe_text(value):
    value = safe_value(value)
    if value is None:
        return None
    return str(value).strip()

def safe_float(value, default=0.0):
    value = safe_value(value)
    if value is None:
        return default
    try:
        number = float(value)
        if not math.isfinite(number):
            return default
        return number
    except (ValueError, TypeError, OverflowError):
        return default

def dataframe_to_tuples(df):
    return [tuple(safe_value(value) for value in row) for row in df.itertuples(index=False, name=None)]

# 4. INSERT BATCH VÀ KIỂM TRA DÒNG LỖI
def insert_batch(cursor, sql, data, table_name):
    if not data:
        print(f"Bảng {table_name} không có dữ liệu.")
        return
    try:
        cursor.executemany(sql, data)
        print(f"Đã nạp {len(data):,} dòng vào {table_name}.")
    except pyodbc.Error as batch_error:
        cursor.connection.rollback()
        print(f"Lỗi INSERT tại bảng {table_name}.")
        for index, record in enumerate(data):
            try:
                cursor.execute(sql, record)
            except pyodbc.Error as row_error:
                cursor.connection.rollback()
                print(f"Bảng lỗi: {table_name}")
                print(f"Vị trí dòng trong batch: {index}")
                print(f"Dữ liệu lỗi: {record!r}")
                print(f"Chi tiết lỗi: {row_error}")
                raise
        cursor.connection.rollback()
        raise RuntimeError(f"INSERT batch thất bại tại {table_name}.") from batch_error

